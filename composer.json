{
    "name": "angeo/module-ucp-catalog",
    "description": "UCP catalog.search, catalog.lookup and get_product implementation for Magento 2 / Adobe Commerce — serves the REST endpoints advertised by angeo/module-ucp (spec 2026-08-25), with real configurable-product variants.",
    "type": "magento2-module",
    "version": "2.1.1",
    "license": "MIT",
    "authors": [
        {
            "name": "Ievgenii Gryshkun",
            "homepage": "https://angeo.dev"
        }
    ],
    "keywords": [
        "magento2",
        "ucp",
        "universal-commerce-protocol",
        "agentic-commerce",
        "aeo",
        "catalog",
        "ai agents"
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "angeo/module-ucp": "^2.1",
        "magento/framework": ">=103.0.6 <104",
        "magento/module-catalog": ">=104.0.6 <105",
        "magento/module-store": ">=101.1.6 <102"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Angeo\\UcpCatalog\\": ""
        }
    },
    "suggest": {
        "magento/module-configurable-product": "Expands configurable products into real UCP variants with option axes. Without it every product is mapped as a single self-variant."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "magento/magento-coding-standard": "^40.0 || ^41.0",
        "phpstan/phpstan": "^2.0",
        "bitexpert/phpstan-magento": "^0.43"
    },
    "autoload-dev": {
        "psr-4": {
            "Angeo\\UcpCatalog\\Test\\": "Test/"
        }
    },
    "support": {
        "issues": "https://github.com/angeo-dev/module-ucp-catalog/issues",
        "source": "https://github.com/angeo-dev/module-ucp-catalog"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "mage-os/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "magento/inventory-composer-installer": false,
            "laminas/laminas-dependency-plugin": false,
            "php-http/discovery": false
        }
    }
}
