{
    "name": "angeo/module-ucp-catalog",
    "description": "UCP catalog.search, catalog.lookup and get_product implementation for Magento 2 / Adobe Commerce — serves the REST endpoints advertised by angeo/module-ucp (spec 2026-08-25), with real configurable-product variants.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Ievgenii Gryshkun",
            "homepage": "https://angeo.dev"
        }
    ],
    "keywords": [
        "magento2",
        "ucp",
        "universal-commerce-protocol",
        "agentic-commerce",
        "aeo",
        "catalog",
        "ai agents"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "angeo/module-ucp": "^2.0",
        "magento/framework": ">=103.0.6",
        "magento/module-catalog": ">=104.0.6",
        "magento/module-store": ">=101.1.6"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Angeo\\UcpCatalog\\": ""
        }
    },
    "suggest": {
        "magento/module-configurable-product": "Expands configurable products into real UCP variants with option axes. Without it every product is mapped as a single self-variant."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Angeo\\UcpCatalog\\Test\\": "Test/"
        }
    },
    "support": {
        "issues": "https://github.com/angeo-dev/module-ucp-catalog/issues",
        "source": "https://github.com/angeo-dev/module-ucp-catalog"
    }
}
